{
  "info": {
    "name": "Tulsi Rust Backend",
    "description": "Generated from the Axum routes in crates/api/src/routes. Run **Auth \u2192 Register** (or Login) first: it stores `token` and `userId`. Create requests store the new id in a collection variable (`taskId`, `boardId`, \u2026) so later requests in the folder work without copy-pasting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "email",
      "value": "jane@example.com"
    },
    {
      "key": "password",
      "value": "password123"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "boardId",
      "value": ""
    },
    {
      "key": "columnId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "labelId",
      "value": ""
    },
    {
      "key": "savedViewId",
      "value": ""
    }
  ],
