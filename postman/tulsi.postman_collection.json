              "raw": "{\n  \"name\": \"My open bugs\",\n  \"description\": \"Bugs assigned to me\",\n  \"filters\": {\n    \"assigned_to\": [\n      \"{{userId}}\"\n    ],\n    \"label_id\": [\n      \"{{labelId}}\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "All filter keys are optional arrays of UUIDs: assigned_to, author, project_id, column_id, label_id. Also created_after / created_before (RFC 3339)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) { const json = pm.response.json(); pm.collectionVariables.set('savedViewId', json.id); }"
                ]
              }
